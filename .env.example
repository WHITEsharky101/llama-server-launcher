# Llama Server Launcher - Environment Variables
# Copy this file to .env and fill in your actual values.
# The .env file is git-ignored and will not be committed.

# API keys for the RP and Coder presets
# (Commit preset shares the Coder key)
API_KEY_rp=your_rp_api_key_here
API_KEY_coder=your_coder_api_key_here

# Paths (optional - defaults point to the LM Studio installation)
#MODELS_DIR=C:\Users\WHITEsharky\.lmstudio\models
#LLAMA_CPP_DIR=C:\Users\WHITEsharky\.lmstudio\extensions\backends\llama-cpp-mtp-turboquant
